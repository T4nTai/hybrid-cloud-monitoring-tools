# =============================================================================
# Docker Environment Template — Azure Central (TICK Stack)
# Copy this file to .env and fill in your values
# =============================================================================

# InfluxDB admin password (used for both InfluxDB and Chronograf)
# Must be set — do NOT leave as default in production
INFLUXDB_PASSWORD=CHANGE_ME_PLEASE

# Optional: override InfluxDB URL if not using docker-compose network
# INFLUXDB_URL=http://influxdb:8086
