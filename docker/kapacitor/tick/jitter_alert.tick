// =============================================================================
// TICKscript: Jitter Alert
// Kịch bản: Cảnh báo khi jitter tăng đột biến so với baseline
//   WARNING  : jitter > 10 ms  (đường truyền bắt đầu không ổn định)
//   CRITICAL : jitter > 25 ms  (không phù hợp cho ứng dụng thời gian thực)
//
// Nguồn dữ liệu: measurement `ping`, field `standard_deviation_ms`
//
// Bối cảnh: jitter baseline on-prem→Singapore qua WireGuard ~1-3 ms.
// Nếu jitter vọt lên > 10 ms, khả năng cao đường truyền ISP đang tắc nghẽn
// hoặc WireGuard tunnel đang có vấn đề (mất gói, retransmit liên tục).
// =============================================================================

stream
    |from()
        .database('monitoring')
        .retentionPolicy('autogen')
        .measurement('ping')
        .groupBy('host', 'url')

    // Window ngắn hơn (1 phút) vì jitter cần phát hiện nhanh
    |window()
        .period(1m)
        .every(30s)

    |mean('standard_deviation_ms')
        .as('jitter_mean')

    |alert()
        .id('jitter-alert/{{ index .Tags "host" }}-to-{{ index .Tags "url" }}')
        .message(
            '[{{ .Level }}] Jitter bất thường {{ index .Tags "host" }} → {{ index .Tags "url" }}: ' +
            '{{ .Fields.jitter_mean | printf "%.2f" }} ms ' +
            '(WARNING > 10ms, CRITICAL > 25ms). ' +
            'Kiểm tra: tắc nghẽn ISP, WireGuard tunnel, CPU tải cao.'
        )
        .warn(lambda: "jitter_mean" > 10.0)
        .crit(lambda: "jitter_mean" > 25.0)
        .stateChangesOnly()

        |influxDBOut()
            .database('monitoring')
            .retentionPolicy('autogen')
            .measurement('alerts_jitter')
            .tag('alert_type', 'jitter')
