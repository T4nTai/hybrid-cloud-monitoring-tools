// =============================================================================
// Jitter Alert — định dạng tương thích Chronograf (editable Alert Rule)
// WARNING > 25 ms, CRITICAL > 50 ms  (window 2m, đã tinh chỉnh theo baseline)
// =============================================================================
var db = 'monitoring'
var rp = 'autogen'
var measurement = 'ping'
var groupBy = ['host', 'url']
var whereFilter = lambda: TRUE
var name = 'Jitter Alert'
var idVar = name + ':{{.Group}}'
var message = '[{{ .Level }}] Jitter {{ index .Tags "host" }} -> {{ index .Tags "url" }}: {{ .Fields.jitter_mean | printf "%.2f" }} ms (WARN>10, CRIT>25)'
var idTag = 'alertID'
var levelTag = 'level'
var messageField = 'message'
var durationField = 'duration'
var outputDB = 'chronograf'
var outputRP = 'autogen'
var outputMeasurement = 'alerts'
var triggerType = 'threshold'
var details = 'Jitter bat thuong'
var warnThreshold = 25.0
var critThreshold = 50.0

var data = stream
    |from()
        .database(db)
        .retentionPolicy(rp)
        .measurement(measurement)
        .groupBy(groupBy)
        .where(whereFilter)
    |window()
        .period(2m)
        .every(30s)
    |mean('standard_deviation_ms')
        .as('jitter_mean')

var trigger = data
    |alert()
        .id(idVar)
        .message(message)
        .details(details)
        .idTag(idTag)
        .levelTag(levelTag)
        .messageField(messageField)
        .durationField(durationField)
        .warn(lambda: "jitter_mean" > warnThreshold)
        .crit(lambda: "jitter_mean" > critThreshold)
        .stateChangesOnly()
        .slack()

trigger
    |influxDBOut()
        .database('monitoring')
        .retentionPolicy('autogen')
        .measurement('alerts_jitter')
        .tag('alert_type', 'jitter')

trigger
    |influxDBOut()
        .create()
        .database(outputDB)
        .retentionPolicy(outputRP)
        .measurement(outputMeasurement)
        .tag('alertName', name)
        .tag('triggerType', triggerType)
