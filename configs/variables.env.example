# =============================================================================
# Biến môi trường cho scripts Phase 7 (benchmark + analysis)
# Copy:   cp configs/variables.env.example configs/variables.env
# rồi điền giá trị thực. File variables.env bị gitignore (không commit).
# =============================================================================

# --- Central (Azure) — InfluxDB + Chronograf + Kapacitor ---
CENTRAL_IP=20.255.72.0
CENTRAL_USER=azureuser
CENTRAL_SSH_KEY=terraform/keys/azure-central-key

# Mật khẩu InfluxDB (lấy từ .env trên Central: cat ~/hybrid-cloud-monitoring/.env)
INFLUXDB_PASSWORD=CHANGE_ME

# --- AWS VM-B (Singapore) ---
VMB_PUBLIC_IP=18.143.221.246
VMB_USER=ubuntu
VMB_SSH_KEY=terraform/keys/vm-b-aws-key

# --- On-prem VM-A ---
VMA_HOST=vm-a
VMA_USER=ubuntu
VMA_SSH_KEY=~/.ssh/id_rsa

# --- WireGuard ---
VPN_SERVER_IP=10.200.200.1   # VM-B (server)
VPN_CLIENT_IP=10.200.200.2   # VM-A (client)

# --- Tham số đo (dùng chung cho các TN) ---
PING_COUNT=100               # số gói mỗi lần ping
PING_INTERVAL=0.2            # giây giữa các gói
REPEATS=3                    # số lần lặp mỗi cấu hình (>=3)
WARMUP=1                     # số lần chạy warm-up (bỏ, không tính kết quả)
