# =============================================================================
# Biến môi trường cho scripts và configs
# Copy file này thành variables.env:  cp variables.env.example variables.env
# Sau đó điền thông tin thực tế
# =============================================================================

# --- Central (Azure Southeast Asia — InfluxDB + Chronograf) ---
AZURE_CENTRAL_IP=<PUBLIC-IP-CUA-AZURE-CENTRAL-VM>
INFLUXDB_URL=http://${AZURE_CENTRAL_IP}:8086
CHRONOGRAF_URL=http://${AZURE_CENTRAL_IP}:8888
INFLUXDB_PASSWORD=<PASSWORD-DUNG-TRONG-DOCKER-COMPOSE>

# --- AWS Agent VMs ---
AWS_VMB_IP=<PUBLIC-IP-CUA-AWS-VM-B>       # Singapore
AWS_VMC_IP=<PUBLIC-IP-CUA-AWS-VM-C>       # Tokyo (optional)
AWS_VMD_IP=<PUBLIC-IP-CUA-AWS-VM-D>       # US-East (optional)

# --- On-Premise VM-A ---
ONPREM_VMA_IP=<IP-CUA-VM-A-TRONG-KVM>     # Lấy bằng: virsh domifaddr vm-a

# --- Telegram bot để nhận alert (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
